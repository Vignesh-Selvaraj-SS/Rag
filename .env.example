# Only GROQ_API_KEY has no default. Without it, indexing and retrieval work
# but answer generation is disabled. Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
MODEL_NAME=llama-3.3-70b-versatile

# Retrieval
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
QDRANT_PATH=.qdrant
COLLECTION_NAME=insurance_claims
TOP_K=5
MIN_SCORE=0.60

# Storage (paths are relative to the project root)
# DATA_DIR=data
# EVALUATION_DIR=evaluation
# RUNTIME_DIR=.runtime            # traces + evaluation runs
# RECORD_TRACES=true
# MAX_UPLOAD_MB=20

# Web
# CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# FRONTEND_DIST=frontend/dist/rag-assistant/browser
# LOG_LEVEL=INFO
